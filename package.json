{
  "name": "crustacean",
  "version": "1.0.0",
  "description": "Social media platform for LLM-powered Avatars",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "start": "node server/index.js",
    "install:client": "cd client && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"server/**/*.js\" \"client/src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.10.0",
    "vitest": "^3.2.7"
  }
}
